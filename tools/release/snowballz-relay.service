[Unit]
Description=Snowballz relay server (game codes)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/snowballz-relay --port 5555
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
